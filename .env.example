# ============================================================
#  复制为 .env.local 后按需修改；.env* 已在 .gitignore 中排除
# ============================================================

# 端口（Next.js 会读 PORT）
PORT=3000

# 监听地址不在这里配：本机模式的绑定地址固定为 127.0.0.1，
# 由 package.json 里 `next dev -H 127.0.0.1` 决定（需求书 §8 第 1 条）。
#
# 局域网模式（阶段 7）只走 `npm run start:lan`：
#   - 它要求先有生产构建（npm run build）
#   - 它在子进程里显式设置 ALLOW_LAN=1，并绑定 0.0.0.0
#   - 它要求下面两行都存在，否则拒绝启动

# 由 `npm run auth:set-password` 生成：
#   scrypt 哈希（不存明文口令；用 : 分隔，避免 .env 的 $ 展开）
# LAB_PASSWORD_HASH=scrypt:32768:8:1:...
# 会话签名密钥（至少 32 字符；换掉 = 所有设备退出）
# SESSION_SECRET=...

# 手动想用环境变量打开局域网时（不推荐，start:lan 会替你做）：
# ALLOW_LAN=1
