# ============================================================
#  复制为 .env.local 后按需修改；.env* 已在 .gitignore 中排除
#  本文件只列阶段 1–2 真正会被读取的变量
# ============================================================

# 端口（Next.js 会读 PORT）
PORT=3000

# 监听地址不在这里配：绑定地址固定为 127.0.0.1，
# 由 package.json 里 `next dev -H 127.0.0.1` 决定（README §8 第 1 条）。
# 阶段 7 的局域网模式会用显式的受控启动方式，不会靠改这个文件。
